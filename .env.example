# Copy to .env and fill in.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID (right-click the server -> Copy Server ID, with Developer Mode on).
# Slash commands sync to this guild instantly. Leave blank to sync globally,
# which can take up to an hour to show up.
GUILD_ID=

# Fallback realm region, used only by raids that don't set their own.
# Each raid stores its own region (the `timezone:` option on /raid create) and
# new raids reuse the last one, so you rarely need to touch this — it just
# decides what the very first raid on a fresh install assumes.
# EU | NA | KR | TW | OCE   (or any IANA name, e.g. Europe/Paris)
RAID_TIMEZONE=EU

# Roles allowed to manage raids, in addition to anyone with Discord's
# Administrator permission. Comma-separated, case-insensitive.
ADMIN_ROLES=Raid Leader,Officer

# Where the SQLite file lives. Default: ./data/raid.sqlite3
# DB_PATH=


# ---------------------------------------------------------------- web manager
# The browser-based roster manager. Leave WEB_BASE_URL blank to keep it off —
# the bot then behaves exactly as it did before, with no port opened.
#
# Set it to the public HTTPS origin you serve the bot from, with no trailing
# slash. This is only used to build the links the bot hands out, so it must
# match what people's browsers actually reach.
# WEB_BASE_URL=https://wow-raid-manager.magdy.org

# Where aiohttp listens. Keep this on loopback and put a TLS reverse proxy
# (Caddy, nginx) in front: the links are bearer credentials and must never
# travel over plain HTTP.
# WEB_BIND=127.0.0.1
# WEB_PORT=8080

# How long an issued link works for. Shorter is safer.
# WEB_TOKEN_TTL_MINUTES=180

# How long after a raid ends its page keeps answering. Expiry only gates
# access — no roster data is deleted.
# WEB_RETENTION_DAYS=30

# Secret used to sign links. Leave unset and the bot generates one on first run
# and stores it in data/.web_secret (mode 0600). Set it explicitly if you run
# more than one instance, or want to invalidate every outstanding link at once
# by changing it.
# WEB_SECRET=
