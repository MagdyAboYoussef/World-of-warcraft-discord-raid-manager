# Copy to .env and fill in.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID (right-click the server -> Copy Server ID, with Developer Mode on).
# Slash commands sync to this guild instantly. Leave blank to sync globally,
# which can take up to an hour to show up.
GUILD_ID=

# Fallback realm region, used only by raids that don't set their own.
# Each raid stores its own region (the `timezone:` option on /raid create) and
# new raids reuse the last one, so you rarely need to touch this — it just
# decides what the very first raid on a fresh install assumes.
# EU | NA | KR | TW | OCE   (or any IANA name, e.g. Europe/Paris)
RAID_TIMEZONE=EU

# Roles allowed to manage raids, in addition to anyone with Discord's
# Administrator permission. Comma-separated, case-insensitive.
ADMIN_ROLES=Raid Leader,Officer

# Where the SQLite file lives. Default: ./data/raid.sqlite3
# DB_PATH=
